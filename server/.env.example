# Копия этого файла с реальными значениями должна лежать в server/.env
# server/.env в git не попадает — см. .gitignore

# Окружение: development | test | production
NODE_ENV=development

# Порт API
PORT=4000

# Подключение к PostgreSQL.
# Спецсимволы в пароле кодируются: @ → %40, : → %3A, / → %2F
DATABASE_URL="postgresql://radeya_app:ПАРОЛЬ@localhost:5432/radeya_mono?schema=public"

# Откуда разрешено обращаться к API. Несколько адресов — через запятую.
CORS_ORIGIN=http://localhost:3000

# Подробность логов: debug | info | warn | error
LOG_LEVEL=info
