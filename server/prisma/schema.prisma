// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Внутри src/, иначе клиент оказывается вне rootDir и ломает tsc.
  // Папка в git не попадает — генерируется командой prisma generate.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Роли сотрудников. Значения обязаны совпадать с USER_ROLES в shared/src/constants/roles.ts.
enum UserRole {
  ADMIN
  MANAGER
  SELLER
}

/// Сотрудник: вход в дашборд по логину. Саморегистрации нет — учётные записи
/// заводит админ. Первый пользователь создаётся, пока таблица пуста.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Только латиница, цифры и `. _ -`, приводится к нижнему регистру до записи.
  login String @unique

  /// Хеш argon2id. Именно хеш, а не пароль: поле не должно попасть наружу ни при какой выборке.
  passwordHash String

  name String

  /// Должность произвольным текстом — заполняет админ при создании.
  position String

  /// Без значения по умолчанию: роль всегда выбирается явно при создании.
  role UserRole

  /// Уволенного сотрудника отключаем, а не удаляем — иначе поедут ссылки в журнале действий.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Кто завёл учётную запись. У первого админа пусто — его никто не создавал.
  createdById  String? @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  sessions Session[]

  /// Заказы, которые сотрудник завёл сам: офлайн-точка, позже сайт.
  soldOrders    Order[]        @relation("OrderSeller")
  orderComments OrderComment[]

  @@index([role])
}

/// Сессия сотрудника. В куке лежит только идентификатор, всё состояние — здесь.
/// Поэтому сессию можно погасить мгновенно: удалили строку — доступ закрыт.
/// С подписанным токеном так не выйдет, он живёт до истечения срока.
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  /// Для раздела «активные сессии» и разбора инцидентов.
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

/// Журнал действий: кто, что и когда сделал. Только вставка и чтение —
/// ни update, ни delete из кода. Журнал, который можно править, журналом не является.
///
/// Связи с User намеренно нет: логин и роль хранятся снимком на момент действия.
/// Иначе после переименования или смены роли вся прошлая история покажет
/// сегодняшние значения, а восстановить исходные будет неоткуда.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  at DateTime @default(now())

  userId    String? @db.Uuid
  userLogin String
  userRole  String

  /// Значение из AUDIT_ACTIONS в shared/src/constants/audit-actions.ts.
  action String

  entityType String?
  entityId   String?

  /// Состояние до и после изменения. Пароли и хеши сюда не попадают.
  before Json?
  after  Json?

  ip String?

  @@index([at])
  @@index([userId])
  @@index([action])
}

/// Склад (точка выдачи) из выгрузки Kaspi. Справочник: заводится один раз из
/// выгрузки, дальше меняется руками. Товары будут ссылаться сюда, а не хранить
/// код склада строкой — иначе опечатка в `PP3` создаст несуществующий склад.
model Warehouse {
  id String @id @default(uuid()) @db.Uuid

  /// Наш короткий код: `PP3`. По нему сверяемся при повторной загрузке выгрузки.
  code String @unique

  /// Как в выгрузке и в заказах Kaspi: `6871008_PP3`. По нему матчатся заказы.
  kaspiStoreId String @unique

  /// Код города по КАТО. У части складов в выгрузке пусто — заполняется руками.
  kaspiCityId String?

  /// Наше название точки. Выгрузка его не содержит, поэтому при повторном
  /// импорте не перезаписывается — иначе введённое руками стиралось бы.
  name String?

  /// Точку закрыли — отключаем, а не удаляем: на неё ссылаются прошлые заказы.
  isActive Boolean @default(true)

  /// Сколько товаров лежало на складе по данным последней синхронизации.
  /// Это снимок кабинета, а не живая цифра: после импорта товаров actual
  /// считается по VariantStock. Нужен, чтобы видеть общую картину до импорта.
  kaspiOffersCount Int?

  /// Сумма остатков по складу на момент той же синхронизации.
  kaspiTotalStock Int?

  /// Контакты точки. Приходят только из кабинета — в Shop API их нет.
  contactName  String?
  contactPhone String?

  /// Как забирают товар: SELF_DELIVERY и т.п. Тоже поле кабинета.
  pickupType String?

  /// Когда снимок сделан. Без даты цифры выше нечем датировать,
  /// и через месяц будет непонятно, свежие они или прошлогодние.
  kaspiStatsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks VariantStock[]
  orders Order[]
}

/// Каналы продаж. Значения обязаны совпадать с SALES_CHANNELS
/// в shared/src/constants/sales-channels.ts.
enum SalesChannel {
  SITE
  KASPI
  OZON
}

/// Статус размещения. Совпадает с LISTING_STATUSES в shared.
enum ListingStatus {
  ON_SALE
  OFF_SALE
}

/// Откуда пришло изменение. Нужен, чтобы отличать правку человека от синхронизации:
/// иначе в истории не понять, кто поставил цену — менеджер или кабинет Kaspi.
enum ChangeSource {
  KASPI_SYNC
  MANUAL
}

/// Вид точки продаж. Значения обязаны совпадать с SALES_POINT_TYPES в shared.
///
/// Не путать с `SalesChannel`: тот про канал размещения товара (`Listing.channel`),
/// этот — про происхождение заказа. Значения похожи, смысл разный.
enum SalesPointType {
  KASPI
  OZON
  SITE
  OFFLINE
}

/// Как заказ едет к покупателю. Измерение независимое от стадии: тип доставки
/// у заказа фиксирован, а стадия меняется по ходу.
enum OrderDeliveryType {
  KASPI
  PICKUP
  OWN
}

/// Стадия заказа — **наша**, вычисленная из полей Kaspi.
///
/// Kaspi отдаёт `status` и `state` по отдельности, и ни одно из них не отвечает
/// на вопрос «что с заказом сейчас»: собранный и отменённый заказ имеет
/// `assembled = true` и `status = CANCELLED` одновременно. Алгоритм сведения —
/// docs/kaspi-api-integration.md, раздел 5.
///
/// PICKUP и OWN_DELIVERY стоят в одном ряду со стадиями намеренно: у таких
/// заказов нет упаковки и передачи курьеру, и в кабинете они живут отдельными
/// разделами. Тип доставки при этом всё равно хранится отдельным полем.
enum OrderStatus {
  NEW
  SIGN_REQUIRED
  PRE_ORDER
  PACKING
  TRANSMISSION
  TRANSMITTED
  PICKUP
  OWN_DELIVERY
  DELIVERED
  CANCELLING
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

/// Категория каталога. Наша собственная: Kaspi отдаёт свои `categoryPathCodes`,
/// но дерево для сайта и для учёта мы строим сами.
model Category {
  id String @id @default(uuid()) @db.Uuid

  name String
  /// Для ЧПУ на витрине.
  slug String @unique

  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  /// Денормализованный путь предков `/id1/id5/`. Без него «все товары поддерева»
  /// превращается в рекурсию на каждый запрос каталога.
  path String @default("/")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  /// Имя уникально внутри одного родителя, а не во всём дереве:
  /// «Угловые» может лежать и под диванами, и под кроватями.
  @@unique([parentId, name])
  @@index([path])
}

/// Карточка модели: «Диван Али». Артикула и цены здесь нет — они у модификации.
/// Из Kaspi на каждый артикул создаётся свой товар; объединение в одну модель
/// с несколькими тканями делается потом руками, когда доберёмся до витрины.
model Product {
  id String @id @default(uuid()) @db.Uuid

  /// Наше название. Приходит из `masterTitle`, дальше правится руками.
  name String

  /// Для ЧПУ на витрине. Заполняется при выводе товара на сайт.
  slug String? @unique

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Из `brandName` кабинета. Не путать с полем `brand` Kaspi — там что-то иное.
  brand String?

  description String?

  /// `familyId` кабинета как есть. По нему модификации одной модели
  /// склеиваются в один товар — но только после проверки человеком.
  kaspiFamilyId String?

  isActive Boolean @default(true)

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]

  @@index([categoryId])
  @@index([kaspiFamilyId])
}

/// Модификация — то, что реально продаётся и имеет артикул. Kaspi матчит
/// позиции заказа по артикулу модификации, поэтому `sku` живёт здесь, а не у товара.
model Variant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Артикул. Ключ сопоставления с кабинетом, выгрузкой и позициями заказов.
  sku String @unique

  /// Штрихкод `ntin` из кабинета.
  barcode String?

  // ——— Поля кабинета Kaspi. Пишет только синхронизация, руками не правим:
  // иначе расхождение с площадкой станет невидимым.

  /// Название карточки на витрине Kaspi — синяя ссылка в кабинете.
  kaspiMasterTitle String?

  /// Наше название в кабинете — серая строка под ссылкой.
  kaspiTitle String?

  /// Поле `model` кабинета. Обычно повторяет `kaspiTitle`, но не всегда.
  kaspiModel String?

  /// Идентификатор карточки на витрине Kaspi.
  kaspiMasterSku String?

  /// Идентификатор нашего предложения — понадобится для смены цен из админки.
  kaspiOfferId String?

  /// Идентификатор выгрузки, из которой товар попал в кабинет.
  kaspiFileId String?

  /// Идентификатор продавца в терминах кабинета.
  kaspiMerchantUid String?

  /// Путь на витрину Kaspi.
  kaspiShopLink String?

  /// Картинки карточки: массив `{ small, medium, large }`. Файлы не выкачиваем —
  /// адреса Kaspi отдаёт готовыми. Json, потому что показываем их целиком и
  /// никогда не ищем по отдельной картинке.
  kaspiImages Json?

  /// История изменений товара в кабинете, как её отдаёт Kaspi. Хранится снимком:
  /// формат недокументированный, разбирать его наугад нельзя, а потерять жалко.
  kaspiUpdates Json?

  /// Когда кабинет последний раз менял товар.
  kaspiUpdatedAt DateTime?

  // ——— Доставка. Четыре флага — зеркало кабинета, их пишет только синхронизация.

  anyKaspiDelivery        Boolean @default(false)
  anyKaspiDeliveryExpress Boolean @default(false)
  anyKaspiDeliveryLocal   Boolean @default(false)
  anyMerchantDelivery     Boolean @default(false)

  /// Пятый флаг — наш: заказ с сайта везём сами. Кабинет о нём не знает.
  siteDelivery Boolean @default(false)

  // ——— Наши поля.

  /// Закупочная цена. Отдаётся только в дашборд (каталог закрыт ролью ADMIN);
  /// на витрину — никогда, и при выдаче каталога другим ролям срезается по роли.
  purchasePrice Decimal? @db.Decimal(12, 2)

  /// Минимальная и максимальная цена по каналам продаж. Денормализация ради
  /// сортировки и фильтра в таблице: считать минимум по размещениям на каждую
  /// строку списка — это запрос на каждый товар.
  minChannelPrice Decimal? @db.Decimal(12, 2)
  maxChannelPrice Decimal? @db.Decimal(12, 2)

  /// Ткань и оттенок для витрины. Kaspi названий тканей не знает — выбираем
  /// вручную из справочника после синхронизации.
  fabricId String?  @db.Uuid
  fabric   Fabric?  @relation(fields: [fabricId], references: [id], onDelete: SetNull)

  fabricShadeId String?      @db.Uuid
  fabricShade   FabricShade? @relation(fields: [fabricShadeId], references: [id], onDelete: SetNull)

  /// Продаём или нет — **наше** решение, общее для всех каналов: сняли здесь,
  /// значит снято и на Kaspi, и на сайте. Не путать с `Listing.status`: там
  /// то, что сейчас по факту на площадке, и расхождение между ними — рабочий
  /// сигнал («мы продаём, а на Kaspi архив»), а не ошибка.
  ///
  /// При импорте приезжает из кабинета: архивный товар заводится снятым.
  status ListingStatus @default(ON_SALE)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings     Listing[]
  stocks       VariantStock[]
  changes      VariantChange[]
  orderEntries OrderEntry[]

  @@index([productId])
  @@index([fabricId])
  @@index([kaspiMasterSku])
}

/// Размещение модификации на канале продаж: цена, статус и идентификаторы площадки.
/// Само наличие записи означает «продаём здесь»: нет строки — канал не используется.
model Listing {
  id String @id @default(uuid()) @db.Uuid

  variantId String  @db.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  channel SalesChannel

  /// Что сейчас по факту на площадке. Пишет синхронизация, руками не меняем:
  /// расхождение с `Variant.isActive` — рабочий сигнал, а не ошибка.
  status ListingStatus @default(ON_SALE)

  /// Основная цена. У Kaspi это зачёркнутая `oldPrice`, когда есть скидка.
  price Decimal? @db.Decimal(12, 2)

  /// Цена со скидкой. Пусто — скидки нет.
  discountPrice Decimal? @db.Decimal(12, 2)

  /// Процент скидки. Считает сервер: обратный счёт от процента не воспроизводит
  /// фактическую цену — расходится на сотни тенге.
  discountPercent Int @default(0)

  /// Идентификатор предложения на площадке: Kaspi `offerId`, OZON `product_id`.
  externalId String?

  /// Идентификатор карточки: Kaspi `masterSku`.
  externalSku String?

  /// Ссылка на витрину площадки.
  externalUrl String?

  publishedAt  DateTime?
  lastSyncedAt DateTime?

  /// Почему последняя синхронизация не прошла. Пусто — прошла.
  syncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один товар не может стоять на канале дважды.
  @@unique([variantId, channel])
  @@index([channel, externalId])
}

/// Остаток модификации на складе. Остаток физический, поэтому висит на модификации,
/// а не на размещении: коробка на складе одна, и показывать её тремя независимыми
/// цифрами для трёх каналов — прямой путь продать то, чего нет.
model VariantStock {
  id String @id @default(uuid()) @db.Uuid

  variantId String  @db.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// Пусто — остаток не указан: товар под заказ. Ноль и «неизвестно» — разное.
  quantity Int?

  /// Срок предзаказа в днях. Один на всех: при импорте приезжает из кабинета,
  /// дальше правится у нас и уходит обратно на площадку. У артикулов, которых
  /// в Kaspi нет, значение ставим сами. 0 — товар в наличии.
  preOrderDays Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

/// Ткань обивки. Справочник для витрины: Kaspi знает только тип ткани,
/// название и палитру ведём у себя и выбираем на артикул из списка.
model Fabric {
  id String @id @default(uuid()) @db.Uuid

  /// Машинное имя для артикулов и адресов: `arben-tessoro`.
  code String @unique

  name String

  /// Тип ткани: велюр, рогожка, экокожа. Это то немногое, что знает Kaspi.
  type String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shades   FabricShade[]
  variants Variant[]
}

/// Оттенок ткани. Принадлежит своей ткани: «серый Tessoro» и «серый Bravo» —
/// разные оттенки, и общим справочником цветов их не выразить.
model FabricShade {
  id String @id @default(uuid()) @db.Uuid

  fabricId String @db.Uuid
  fabric   Fabric @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  code String
  name String

  /// Цвет плашки на витрине, если фото образца нет.
  hex String?

  /// Фото образца ткани.
  imageUrl String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants Variant[]

  @@unique([fabricId, code])
}

/// История изменений по артикулу: что поменялось, когда и откуда.
/// Отдельно от `AuditLog`: тот про действия сотрудников, а сюда попадают
/// и правки человека, и то, что приехало из кабинета Kaspi.
model VariantChange {
  id String @id @default(uuid()) @db.Uuid

  variantId String  @db.Uuid
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Имя изменившегося поля: `purchasePrice`, `listing.KASPI.price`.
  field String

  /// Значения строками: поля разного типа, а история read-only —
  /// считать по ней ничего не будем, только показывать.
  oldValue String?
  newValue String?

  source ChangeSource

  /// Кто изменил. Пусто для синхронизации: у неё нет автора.
  userId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
}

/// Клиент магазина: регистрируется сам с витрины, вход отдельный от дашборда.
/// Ролей у клиента нет — права сотрудников к нему неприменимы.
model Customer {
  id String @id @default(uuid()) @db.Uuid

  login        String @unique
  passwordHash String
  name         String

  /// Нормализуется до записи в единый формат (+7XXXXXXXXXX), иначе уникальность не сработает.
  phone String @unique

  /// Необязательный. PostgreSQL допускает любое количество NULL в уникальном индексе,
  /// поэтому «нужен не всем, но не повторяется» — это одно поле без ухищрений.
  email String? @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Заказ. Пока только из Kaspi, поэтому полей площадки здесь много.
///
/// Данные приходят из двух источников, и это важно помнить, читая модель:
///
///   Shop API (токен, работает)  — статусы, даты, деньги, адреса, накладная.
///   Кабинет (кука, вручную)     — сроки этапов, зоны, модерация, суммы рассрочки.
///
/// Поля кабинета заведены сразу и помечены ниже. Пока они пустые: заполнит их
/// отдельная кнопка на заказе, когда решится вопрос с доступом. Заводим сейчас,
/// чтобы не делать вторую миграцию на те же данные.
/// Точка продаж: и площадки (Kaspi, Ozon, сайт), и офлайн-магазины в одной
/// таблице.
///
/// Единый справочник, а не «перечисление для площадок плюс таблица для офлайна»:
/// иначе фильтр в реестре и разрез статистики пришлось бы каждый раз склеивать
/// из двух источников, а запрос «Kaspi и точка на Абая вместе» не написать одним
/// `GROUP BY`.
model SalesPoint {
  id String @id @default(uuid()) @db.Uuid

  /// Стабильный читаемый ключ: `KASPI`, `OZON`, `SITE`, `OFF-1`.
  ///
  /// Синхронизация ищет точку Kaspi по коду, а не по id: uuid на каждой базе
  /// свой, а код одинаков везде. Поэтому код неизменен, в отличие от названия.
  code String @unique

  /// Название для людей. Переименовывается свободно — связи идут по id,
  /// и прошлая статистика от переименования не разъезжается.
  name String

  type SalesPointType

  /// Закрытая точка не предлагается при создании заказа, но остаётся в фильтрах
  /// и отчётах. Удаления нет вовсе: на точке висят заказы.
  isActive Boolean @default(true)

  /// Порядок в списках. Задаётся руками: алфавит ставит «Абая» выше Kaspi,
  /// хотя открывают чаще Kaspi.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([type])
  @@index([isActive])
}

/// Комментарий к заказу.
///
/// Лента, а не одно поле в `Order`: заказ по очереди трогают продавец, сборщик
/// и доставка, и одна колонка означала бы «кто написал последним, тот и стёр
/// предыдущего». Правки и удаления нет — комментарий, который можно подтереть,
/// доверия не заслуживает.
model OrderComment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Автор. Restrict: сотрудника не удаляют, а отключают, и комментарий обязан
  /// остаться с подписью.
  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// Роль снимком — на момент написания. Продавец мог стать менеджером, а «это
  /// писал продавец» — часть смысла записи. Имя, наоборот, берётся из `User`
  /// по связи: переименовали сотрудника — поправилось во всех комментариях.
  authorRole UserRole

  text String

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([authorId])
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  /// Откуда заказ: площадка или конкретная офлайн-точка. Обязательное —
  /// заказ без происхождения не посчитать ни в одном разрезе статистики.
  salesPointId String     @db.Uuid
  salesPoint   SalesPoint @relation(fields: [salesPointId], references: [id], onDelete: Restrict)

  /// Кто завёл заказ. Пусто у заказов площадки — их никто не заводил руками.
  ///
  /// Отдельного поля «источник» для интерфейса не нужно: пусто — показываем
  /// название точки продаж, заполнено — имя сотрудника.
  sellerId String? @db.Uuid
  seller   User?   @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  /// Ресурсный id Kaspi (`MTA1NTgxNTk1Nw` — base64 от номера). По нему тянется
  /// состав заказа: в адресе `/orders/{id}/entries` стоит именно он, а не номер.
  kaspiId String? @unique

  /// Номер заказа, который видит покупатель. Ключ сопоставления двух источников:
  /// ресурсного id в данных кабинета нет.
  code String @unique

  // ——— Статусы

  /// Наша стадия. Считается из полей Kaspi, руками не выставляется.
  status OrderStatus

  /// Тип доставки. Отдельное измерение: у заказа он не меняется.
  deliveryType OrderDeliveryType

  /// `status` Kaspi как есть: COMPLETED, ACCEPTED_BY_MERCHANT, CANCELLED и т.п.
  /// Храним сырым, потому что наша стадия — производная, и при ошибке в правиле
  /// пересчитать её можно только из исходных значений.
  kaspiStatus String

  /// `state` Kaspi: NEW, SIGN_REQUIRED, PICKUP, DELIVERY, KASPI_DELIVERY, ARCHIVE.
  kaspiState String?

  // ——— Отмены, возвраты, модерация

  /// Причина отмены из Shop API (`attributes.cancellationReason`).
  cancellationReason String?

  /// Причина и подпричина из кабинета — они подробнее, чем одна строка Shop API.
  cancelReason    String?
  cancelSubReason String?

  /// Модерация заказа Kaspi. Только кабинет.
  moderated          Boolean?
  moderatedReason    String?
  moderatedSubReason String?

  // ——— Даты. Kaspi отдаёт их в Unix-миллисекундах UTC, храним как время.

  /// Когда заказ оформлен. У Kaspi это `creationDate`, у офлайн-точки — момент
  /// ввода продавцом. Не путать с `createdAt` — тот про нашу запись.
  ///
  /// Имя нейтральное намеренно: статистика за период обязана считать все
  /// источники по одной дате, а `createdAtKaspi` у офлайн-заказа означал бы
  /// событие, которого не было.
  placedAt DateTime

  /// Когда Kaspi последний раз менял заказ. Только кабинет.
  updatedAtKaspi DateTime?

  approvedByBankAt DateTime?
  completedAt      DateTime?

  /// Факт сборки. Только кабинет; в Shop API есть лишь флаг `assembled`.
  assembledAt DateTime?

  /// Факт передачи курьеру. Проставлена — заказ уже уехал.
  courierTransmissionAt DateTime?

  /// План передачи курьеру. Это и есть дедлайн «отвезите в пункт приёма».
  courierTransmissionPlannedAt DateTime?

  /// Плановая и фактическая доставка клиенту. Только кабинет.
  plannedDeliveryAt DateTime?
  actualDeliveryAt  DateTime?

  /// Возврат на склад: когда вернулся и до какого срока лежит. Только кабинет.
  returnedToWarehouseAt        DateTime?
  returnedToWarehouseTimeoutAt DateTime?

  // ——— Деньги

  totalPrice            Decimal  @db.Decimal(12, 2)
  /// Сколько за доставку платит покупатель и сколько удерживают с нас.
  deliveryCost          Decimal? @db.Decimal(12, 2)
  deliveryCostForSeller Decimal? @db.Decimal(12, 2)

  /// Сумма рассрочки с наценкой банка — она больше цены товара. Только кабинет.
  loanAmount Decimal? @db.Decimal(12, 2)

  /// PAY_WITH_CREDIT и подобное, плюс срок рассрочки в месяцах.
  paymentMode String?
  creditTerm  Int?

  signatureRequired Boolean @default(false)

  // ——— Доставка и флаги

  /// Товара нет в наличии — заказ приехал предзаказом.
  preOrder Boolean @default(false)

  assembled       Boolean @default(false)
  isKaspiDelivery Boolean @default(false)
  isExpress       Boolean @default(false)

  /// Посылка доехала до пункта выдачи. Только кабинет.
  isOrderArrived Boolean?

  returnedToWarehouse Boolean @default(false)

  /// DELIVERY_PICKUP, DELIVERY_LOCAL, DELIVERY_REGIONAL_*. Осторожно:
  /// DELIVERY_REGIONAL_PICKUP — это Kaspi-доставка в пункт выдачи,
  /// а не самовывоз покупателем.
  deliveryMode String?

  /// STANDARD и зона доставки (REGIONAL и т.п.). Только кабинет.
  deliveryMethod String?
  deliveryZone   String?

  /// Мест груза. Только кабинет.
  cargoSpace Int?

  /// Накладная Kaspi. Появляется раньше, чем статус «принят», поэтому по ней
  /// надёжнее определять принятый заказ, чем по самому статусу.
  waybillNumber    String?
  firstMileCourier String?

  // ——— Покупатель.
  //
  // Персональные данные. Наружу отдаются только сотрудникам и только там, где
  // без них не обойтись; на витрину не уходят никогда. У архивных заказов Kaspi
  // отдаёт телефон замаскированным (`+0(000)-000-00-00`) — сохраняем как есть,
  // подставлять вместо маски пустоту нельзя: разница «нет телефона» и
  // «Kaspi его скрыл» видна только по значению.

  kaspiCustomerId   String?
  customerName      String?
  customerFirstName String?
  customerLastName  String?
  customerPhone     String?

  // ——— Адрес доставки.
  //
  // У Kaspi-доставки он почти всегда пуст: домашний адрес площадка не отдаёт.
  // Заполнен он у своей доставки — там мы везём сами, и без адреса не поедем.

  /// Код города из кабинета; в Shop API есть только название.
  deliveryCityId           String?
  deliveryTown             String?
  deliveryDistrict         String?
  deliveryStreetName       String?
  deliveryStreetNumber     String?
  deliveryBuilding         String?
  deliveryApartment        String?
  deliveryFloor            String?
  deliveryEntrance         String?
  deliveryIntercom         String?
  deliveryComment          String?
  deliveryIsPrivateHouse   Boolean?
  deliveryFormattedAddress String?
  deliveryLatitude         Float?
  deliveryLongitude        Float?

  // ——— Склад отгрузки

  /// Наш склад. Может быть пуст: Kaspi называет точку, которой ещё нет
  /// в справочнике, и терять из-за этого заказ нельзя.
  warehouseId String?    @db.Uuid
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  /// Идентификатор точки как его прислал Kaspi: `6871008_PP27`. Остаётся даже
  /// когда склад не нашёлся — по нему потом и свяжем.
  kaspiPickupPointId String?

  /// Город отгрузки снимком: справочник складов могут поправить, а заказ должен
  /// помнить, откуда уехал на самом деле.
  originCityId           String?
  originCityName         String?
  originFormattedAddress String?

  /// Ответ Kaspi целиком. Формат недокументирован и меняется — потерять поле,
  /// которое понадобится через полгода, дороже, чем хранить json.
  raw        Json?
  /// Отдельно ответ кабинета: источники разные, мешать их в одном поле нельзя.
  rawCabinet Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries  OrderEntry[]
  markers  OrderMarker[]
  steps    OrderStep[]
  comments OrderComment[]

  @@index([status])
  @@index([placedAt])
  @@index([warehouseId])
  @@index([kaspiPickupPointId])
  /// Составные, а не по одному полю: оба разреза статистики — «точка за период»
  /// и «продавец за период» — читаются одним проходом по индексу, без сортировки.
  @@index([salesPointId, placedAt])
  @@index([sellerId, placedAt])
}

/// Позиция заказа. В списке заказов их нет — приходят отдельным запросом
/// `/orders/{id}/entries`, поэтому тянутся своим проходом.
model OrderEntry {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Номер позиции внутри заказа — ключ повторяемой загрузки. У заказов, где
  /// позиций нет вовсе, ставим -1 заглушкой, иначе их состав будут тянуть вечно.
  entryNumber Int

  /// Идентификатор позиции у Kaspi: `1055815957##0`.
  kaspiEntryId String?

  /// Наш артикул (`offer.code` в Shop API, `merchantProduct.code` в кабинете).
  /// По нему связываемся с каталогом.
  sku String?

  /// Модификация из нашего каталога. Пусто — товара у нас ещё нет: заказ мог
  /// приехать по артикулу, который не импортирован.
  variantId String?  @db.Uuid
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Название нашего предложения и название карточки Kaspi — они разные.
  offerName        String?
  kaspiProductCode String?
  kaspiProductName String?

  /// Штрихкод и признак IMEI приходят только из кабинета.
  barcode        String?
  isImeiRequired Boolean?

  quantity Int @default(1)

  basePrice    Decimal? @db.Decimal(12, 2)
  totalPrice   Decimal? @db.Decimal(12, 2)
  deliveryCost Decimal? @db.Decimal(12, 2)

  categoryCode  String?
  categoryTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, entryNumber])
  @@index([sku])
  @@index([variantId])
}

/// Событие в истории заказа: кто и когда его двигал.
///
/// Только из кабинета — в Shop API истории нет вовсе. Таблица заведена заранее
/// и будет пустой, пока не появится доступ.
model OrderMarker {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// APPROVED_BY_BANK, ACCEPTED_BY_MERCHANT и т.п.
  marker String

  at DateTime

  /// Имя сотрудника или покупателя как его показывает кабинет.
  userName String?

  /// Одно и то же событие не должно задваиваться при повторной загрузке.
  @@unique([orderId, marker, at])
  @@index([orderId])
}

/// Этап заказа со сроками: APPROVAL, ACCEPTANCE, TRANSMISSION, TRANSIT, DELIVERY.
///
/// Только из кабинета. Ценны именно сроками: `timeoutAt` — дедлайн, после
/// которого Kaspi наказывает, а в Shop API таких дат нет.
model OrderStep {
  id String @id @default(uuid()) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  step String

  /// PASSED, CURRENT, UNKNOWN.
  status String

  plannedAt      DateTime?
  timeoutAt      DateTime?
  additionalDays Int?

  @@unique([orderId, step])
  @@index([orderId])
}
