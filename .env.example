# Единый файл переменных окружения на весь монорепозиторий.
# Скопируй в .env в этой же папке и подставь реальные значения.
# .env в git не попадает — см. .gitignore.
#
# Правило: всё, что начинается с NEXT_PUBLIC_, попадает в браузер.
# Секреты с таким префиксом класть нельзя.

# ── Общее ──

# Окружение: development | test | production
NODE_ENV=development

# ── Сервер (server/) ──

# Порт API
PORT=4000

# Подключение к PostgreSQL.
# Спецсимволы в пароле кодируются: @ → %40, : → %3A, / → %2F
DATABASE_URL="postgresql://radeya_app:ПАРОЛЬ@localhost:5432/radeya_mono?schema=public"

# Откуда разрешено обращаться к API. Несколько адресов — через запятую.
CORS_ORIGIN=http://localhost:3000

# Подробность логов: debug | info | warn | error
LOG_LEVEL=info

# ── Kaspi ──

# Идентификатор продавца, он же в шапке кабинета. Не секрет, но у каждого свой.
KASPI_MERCHANT_ID=6871008

# Токен Kaspi Shop API: кабинет → Настройки → API. Постоянный.
# Это доступ к магазину — в git не попадает, в логи и ответы не выводится.
KASPI_API_TOKEN=

# Ключ шифрования email/пароля и сессии кабинета Kaspi в базе: 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Сменили ключ — сохранённые данные для входа придётся ввести заново.
# Пустым не оставлять: пустое значение сервер отклонит на старте — либо ключ, либо строки нет.
# KASPI_SECRETS_KEY=

# ── Фронт (front/) ──

# Адрес API для браузера
NEXT_PUBLIC_API_URL=http://localhost:4000/api
